# Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT=https://alliander-foundry-uvrqgq.services.ai.azure.com/api/projects/alliander-project
FOUNDRY_MODEL=gpt-4o

# Same values under the Azure SDK env-var names (used by FoundryChatClient internals)
AZURE_AI_PROJECT_ENDPOINT=https://alliander-foundry-uvrqgq.services.ai.azure.com/api/projects/alliander-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# Azure AI Search (not used by lab 1 — fill in later for labs 5+)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_INDEX=idx_bls_corpus
AZURE_SEARCH_RO_INDEX=idx_raamopdrachten
AZURE_SEARCH_CREW_INDEX=idx_crew
AZURE_SEARCH_CONNECTION_NAME=

# Foundry Agent Names (populated by scripts/deploy_agents.py)
DRAAD_RETRIEVER_AGENT=draad-procedure-retriever
DRAAD_MATCHER_AGENT=draad-dispatch-matcher
DRAAD_REVIEWER_AGENT=draad-dispatch-reviewer
DRAAD_QA_AGENT=draad-qa-assistant

# FastAPI
ALLOWED_ORIGINS=http://localhost:3000

# Tuning
SEARCH_TOP_K=6
MAX_REVISIONS=2
