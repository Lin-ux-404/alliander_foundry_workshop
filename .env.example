# Workshop identity and Azure scope
WORKSHOP_TOPOLOGY=TeamIsolated
WORKSHOP_RESOURCE_NAMESPACE=team-01
TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=<team-resource-group>
AZURE_LOCATION=swedencentral

# Microsoft Foundry
FOUNDRY_ACCOUNT_NAME=<foundry-account>
FOUNDRY_PROJECT_NAME=<foundry-project>
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=<deployed-model-name>

# Azure AI Search (Microsoft Entra authentication; no participant API key)
AZURE_SEARCH_SERVICE_NAME=<search-service>
AZURE_SEARCH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Search/searchServices/<search-service>
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_INDEX=idx_bls_corpus-team-01
AZURE_SEARCH_RO_INDEX=idx_raamopdrachten-team-01
AZURE_SEARCH_CREW_INDEX=idx_crew-team-01
AZURE_SEARCH_CONNECTION_NAME=<foundry-search-connection>
LAB_SEARCH_INDEX=idx_bls_corpus-team-01

# Foundry IQ stretch lab
FOUNDRY_IQ_KNOWLEDGE_BASE=grid-operations-kb-team-01
FOUNDRY_IQ_PROCEDURES_INDEX=idx_bls_corpus-team-01
FOUNDRY_IQ_RAAMOPDRACHTEN_INDEX=idx_raamopdrachten-team-01
FOUNDRY_IQ_CREW_INDEX=idx_crew-team-01
FOUNDRY_IQ_PROCEDURES_SOURCE=bls-knowledge-source-team-01
FOUNDRY_IQ_RAAMOPDRACHTEN_SOURCE=raamopdrachten-knowledge-source-team-01
FOUNDRY_IQ_CREW_SOURCE=crew-knowledge-source-team-01
FOUNDRY_IQ_MCP_CONNECTION_NAME=grid-operations-kb-team-01-connection
FOUNDRY_IQ_API_VERSION=2026-05-01-preview
FOUNDRY_IQ_MODEL=gpt-4.1-mini
# The 2026-05-01-preview REST enum and current live service use
# "extractiveData". Keep this configurable while the preview contract evolves.
FOUNDRY_IQ_OUTPUT_MODE=extractiveData
# Runtime source controls used by the end-to-end IQ evaluation. Structured
# six-row lookup indexes need a lower semantic threshold than procedure pages.
FOUNDRY_IQ_PROCEDURE_RERANKER_THRESHOLD=2.0
FOUNDRY_IQ_STRUCTURED_RERANKER_THRESHOLD=1.5
# Preview retrieve requires each per-source candidate cap to be 50..200. The
# notebook separately limits the final cross-source response to 12 documents.
FOUNDRY_IQ_SOURCE_CANDIDATE_CAP=50

# Observability and evaluation
WORKSHOP_ALLOW_CLEANUP=false
# Repeat each Foundry IQ benchmark case so the release view exposes instability.
RAG_EVAL_REPEATS=3
# Optional contract-specific rates for the live RAG cost estimate. Leave blank
# to track requests and tokens without presenting an inaccurate USD estimate.
RAG_MODEL_INPUT_USD_PER_1M_TOKENS=
RAG_MODEL_OUTPUT_USD_PER_1M_TOKENS=
RAG_SEMANTIC_RANKER_USD_PER_1000_REQUESTS=
RAG_AGENTIC_RETRIEVAL_USD_PER_1M_TOKENS=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=<storage-account>
AZURE_STORAGE_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Storage/storageAccounts/<storage-account>
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_CREW_CONTAINER=crew-data-team-01
AZURE_STORAGE_CREW_BLOB=crew.json
AZURE_STORAGE_RO_BLOB=raamopdrachten.json

# Foundry prompt-agent names
DRAAD_RETRIEVER_AGENT=draad-procedure-retriever-team-01
DRAAD_MATCHER_AGENT=draad-dispatch-matcher-team-01
DRAAD_REVIEWER_AGENT=draad-dispatch-reviewer-team-01
DRAAD_QA_AGENT=draad-qa-assistant-team-01

# Application and tuning
ALLOWED_ORIGINS=http://localhost:3000
SEARCH_TOP_K=6
MAX_REVISIONS=2
